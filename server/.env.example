# Optional local persistence key. Generate with: openssl rand -base64 32
# Keep this key durable and server-only; changing it makes saved credentials unreadable.
# If omitted in development, Civitai keys remain in process memory only.
STUDIO_ENCRYPTION_KEY=
# Alternative: a restricted server-only file outside the repository containing
# the same 32-byte base64 key. Configure inline OR file, never both.
# STUDIO_ENCRYPTION_KEY_FILE=C:/private/civitai-studio/encryption.key

# Production also requires NODE_ENV=production, PUBLIC_BASE_URL=https://..., and
# a durable server-only STUDIO_ENCRYPTION_KEY or STUDIO_ENCRYPTION_KEY_FILE.
PUBLIC_BASE_URL=http://localhost:6969
PORT=6969
# STUDIO_DATABASE_PATH=./data/studio.sqlite
# Use a durable path with the encryption key for persistence. :memory: is local-only.

# Optional OAuth: complete valid configuration enables Connect with Civitai.
# Register a confidential client with scope mask 376933 and the exact callback.
# Never use VITE_ for either value.
CIVITAI_CLIENT_ID=
CIVITAI_CLIENT_SECRET=
# Must exactly match PUBLIC_BASE_URL origin plus the fixed callback and registration.
CIVITAI_REDIRECT_URI=http://localhost:6969/api/studio/v1/civitai/oauth/callback
# OAuth uses the same persistent encryption key configured above (inline or file).

# Only behind a trusted TLS proxy preserving Host and sanitizing forwarded headers:
# STUDIO_TRUST_PROXY=true

# Optional LOCAL filesystem output saving. Never available in production.
# Requires literal loopback HOST, loopback PUBLIC_BASE_URL, and no trusted proxy.
# Choose an existing base directory in Settings; the account folder is added there.
HOST=127.0.0.1
STUDIO_LOCAL_OUTPUTS=false

# In local mode, Settings auto-save defaults ON after destination configuration.
# The account-scoped toggle/cutoff/queue live in SQLite, not environment variables.
# Background read-only status/history checks and downloads run while Bun is open.
# New exports use images|videos|3d-models|lora / YYYY-MM-DD (UTC).
